{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bingo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Games, pools, boards, marks, reports. Schema changes: npm run db:remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bingo",
      "database_id": "b6a98e02-9a16-4803-8a09-5141d45c8eb4"
    }
  ],

  // Public identifiers (not secrets). Fill in once the Apple and Google apps exist.
  "vars": {
    "APPLE_TEAM_ID": "",
    "APPLE_BUNDLE_ID": "",
    "GOOGLE_WEB_CLIENT_ID": "",
    "GOOGLE_IOS_CLIENT_ID": "",
    "APP_STORE_URL": ""
  },

  // Invite links (https://<domain>/join/CODE) need a real domain for universal links:
  // "routes": [{ "pattern": "example.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
